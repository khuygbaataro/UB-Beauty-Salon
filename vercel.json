{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/status", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!api/).+)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/cron/reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
