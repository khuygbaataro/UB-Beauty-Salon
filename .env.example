# ─────────────────────────────────────────────────────────────
#  UB Beauty Salon chatbot — орчны хувьсагчид (environment variables)
#  Энэ файлыг .env болгон хуулж, утгуудаа бөглөнө.
#  Vercel дээр Project Settings → Environment Variables дотор тохируулна.
# ─────────────────────────────────────────────────────────────

# --- Anthropic (Admin AI-д хэрэглэнэ) ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5
# Admin AI-ийн модель (Claude).
ADMIN_MODEL=claude-opus-5

# --- Redis хадгалалт (Upstash эсвэл Vercel KV) ---
# Upstash: https://console.upstash.com → Redis database → REST API хэсгээс
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Эсвэл Vercel KV ашиглавал KV_REST_API_URL / KV_REST_API_TOKEN автоматаар орж ирнэ)

# --- OpenAI (Customer AI-д хэрэглэнэ) ---
OPENAI_API_KEY=sk-...
# Үйлчлүүлэгчийн AI-ийн модель (OpenAI).
CUSTOMER_MODEL=gpt-5.6-luna

# --- Facebook Messenger (үйлчлүүлэгчийн AI) ---
# Webhook баталгаажуулалтын токен (өөрөө зохионо, FB App дээр ижил утгыг оруулна)
FB_VERIFY_TOKEN=ub-beauty-verify-123
# Facebook Page-ийн Page Access Token
FB_PAGE_ACCESS_TOKEN=
# (Заавал биш) webhook гарын үсгийг шалгах App Secret
FB_APP_SECRET=

# --- Cloudinary (зураг байршуулах) ---
# Telegram-аар илгээсэн үйлчилгээний зургийг энд жижигрүүлж байршуулна.
# Cloudinary Dashboard → "API Environment variable" дэх CLOUDINARY_URL-ийг хуулж тавь:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# (Эсвэл тус тусад нь: CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET)

# --- Facebook Messenger (АРТИСТын AI — тусдаа хуудас) ---
# Артистуудад зориулсан ТУСДАА Facebook Page-ийн Access Token.
# Тохируулаагүй бол (dev) үйлчлүүлэгчийн хуудасныхыг түр ашиглана.
ARTIST_PAGE_ACCESS_TOKEN=
# Артистын хуудасны webhook verify token. Тохируулаагүй бол FB_VERIFY_TOKEN-ийг ашиглана.
ARTIST_FB_VERIFY_TOKEN=ub-beauty-artist-verify-123

# --- Admin AI (ажилчидтай харилцах суваг) ---
# Админ сувгийн төрөл: telegram | messenger
ADMIN_CHANNEL=telegram
# Telegram bot token (ADMIN_CHANNEL=telegram үед)
TELEGRAM_BOT_TOKEN=
# Зөвхөн эдгээр Telegram chat ID-аас ирсэн командыг хүлээн авна (таслалаар тусгаарлана)
ADMIN_ALLOWED_IDS=

# --- Ажиллах цаг / цагийн хуваарь ---
SALON_OPEN_HOUR=10
SALON_CLOSE_HOUR=19
# Нэг слотын урт (минут) — үйлчилгээ 30мин–1цаг
SLOT_MINUTES=60
# Эхэлж санал болгох цонх (өглөө)
PRIORITY_START_HOUR=10
PRIORITY_END_HOUR=13

# --- Төлбөр ---
# Урьдчилгаа идэвхжүүлэх эсэх. Одоогоор false (урьдчилгаагүй).
PREPAYMENT_ENABLED=false

# --- Цаг цуцлах / сануулга ---
# Цаг цуцлахдаа хэдэн цагийн өмнө мэдэгдэх нь зүйтэй (зөөлөн сануулга)
CANCEL_NOTICE_HOURS=4
# Сануулга хэдэн цагийн өмнө илгээх (default 2 цаг)
REMINDER_LEAD_HOURS=2

# --- Cron хамгаалалт (Vercel Cron дуудах endpoint-ийг хамгаалах) ---
CRON_SECRET=

# --- Цагийн бүс ---
TZ=Asia/Ulaanbaatar

# --- Байгууллагын холбоо барих мэдээлэл (бот мэдэхгүй үед санал болгоно) ---
SALON_PHONE=
SALON_LOCATION=
